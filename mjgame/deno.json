{
  "tasks": {
    "play": "deno run --allow-read --allow-write --allow-ffi --allow-env=MJGAME_NATIVE src/main.ts play",
    "selfplay": "deno run --allow-read --allow-write --allow-ffi --allow-env=MJGAME_NATIVE src/main.ts selfplay",
    "bench": "deno run --allow-read --allow-ffi --allow-env=MJGAME_NATIVE src/main.ts bench",
    "check": "deno check src/*.ts src/*/*.ts scripts/*.ts",
    "tune": "deno run --allow-read --allow-write --allow-run=deno scripts/tune.ts",
    "freeze": "deno run --allow-read --allow-write scripts/freeze.ts",
    "arena": "deno run --unstable-net --allow-net=game.riichi.dev --allow-read --allow-write --allow-ffi --allow-env=MJGAME_NATIVE src/net/arena.ts",
    "test": "deno test --allow-read --allow-write --allow-ffi --allow-env=MJGAME_NATIVE --allow-run=clang,clang++",
    "build-native": "clang -O3 -dynamiclib -framework Accelerate -o native/librlnet.dylib native/rlnet.c",
    "build-kernel": "sh native/build_kernel.sh",
    "build-mlp": "sh native/build_mlp.sh",
    "build-ev": "sh native/build_ev.sh",
    "fmt": "deno fmt"
  },
  "imports": {
    "mjrender/": "../mjrender/src/",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "fast-xml-parser": "npm:fast-xml-parser@^4.5.7"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true
  }
}
